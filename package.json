{
  "name": "typed-settings",
  "version": "0.1.4",
  "description": "One-call typed config for TS: env + .env + yaml/toml/json + secrets-dir + vault -> frozen object. Standard Schema + legacy bridges.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./zod": {
      "types": "./dist/adapters/zod.d.ts",
      "import": "./dist/adapters/zod.js",
      "require": "./dist/adapters/zod.cjs"
    },
    "./yup": {
      "types": "./dist/adapters/yup.d.ts",
      "import": "./dist/adapters/yup.js",
      "require": "./dist/adapters/yup.cjs"
    },
    "./joi": {
      "types": "./dist/adapters/joi.d.ts",
      "import": "./dist/adapters/joi.js",
      "require": "./dist/adapters/joi.cjs"
    },
    "./superstruct": {
      "types": "./dist/adapters/superstruct.d.ts",
      "import": "./dist/adapters/superstruct.js",
      "require": "./dist/adapters/superstruct.cjs"
    },
    "./vault-hashicorp": {
      "types": "./dist/vault/hashicorp.d.ts",
      "import": "./dist/vault/hashicorp.js",
      "require": "./dist/vault/hashicorp.cjs"
    },
    "./vault-aws": {
      "types": "./dist/vault/aws.d.ts",
      "import": "./dist/vault/aws.js",
      "require": "./dist/vault/aws.cjs"
    },
    "./vault-http": {
      "types": "./dist/vault/http.d.ts",
      "import": "./dist/vault/http.js",
      "require": "./dist/vault/http.cjs"
    },
    "./next": {
      "types": "./dist/framework/next.d.ts",
      "import": "./dist/framework/next.js",
      "require": "./dist/framework/next.cjs"
    },
    "./vite": {
      "types": "./dist/framework/vite.d.ts",
      "import": "./dist/framework/vite.js",
      "require": "./dist/framework/vite.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "typed-settings": "bin/typed-settings.mjs"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/check-size.mjs"
  },
  "keywords": [
    "config",
    "env",
    "dotenv",
    "zod",
    "valibot",
    "settings",
    "standard-schema"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prosubodh/typed-settings"
  },
  "homepage": "https://github.com/prosubodh/typed-settings#readme",
  "bugs": {
    "url": "https://github.com/prosubodh/typed-settings/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "arktype": ">=2",
    "valibot": ">=1",
    "zod": ">=3.24"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "arktype": {
      "optional": true
    }
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^3.2.7",
    "arktype": "^2.1.0",
    "smol-toml": "^1.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "valibot": "^1.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.0 || ^4.0.0"
  }
}
